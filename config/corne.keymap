#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | TAB  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | LCTRL|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |  ~   |
//                    | GUI | LWR | SPC |   | ENT | RSE  | RSHFT |
                        bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp TAB   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp TILDE
                   &kp LGUI    &mo 1 &kp SPACE  &kp RET &mo 2 &kp RSHFT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | LSHFT|     |     |     |     | LALT|   | LFT | DWN |  UP | RGT |     |      |
// | LCTRL|     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | RALT|
                        bindings = <
   &kp ESC    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &kp LSHFT  &trans       &trans       &trans       &trans       &kp LALT       &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LCTRL  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI         &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  !  |  @  |  #  |  $  |  %  |   |  ^  |  (  |  )  |  &  |  *  | BSPC |
// | LSHFT|     |     |  /  |  ~  |  \  |   |  -  |  [  |  ]  |  =  |     |     |
// | LCTRL|     |     | "|" |  `  |     |   |  _  |  {  |  }  |  +  |     |     |
//                    | GUI |     | SPC |   | ENT |     | RALT|
                        bindings = <
   &kp  ESC  &kp EXCL &kp AT   &kp HASH   &kp DLLR  &kp PRCNT   &kp CARET &kp LPAR  &kp RPAR  &kp AMPS  &kp ASTRK &kp BSPC
   &kp LSHFT &trans   &trans   &kp FSLH   &kp TILDE &kp BSLH    &kp MINUS &kp LBKT  &kp RBKT  &kp EQUAL &trans    &trans
   &kp LCTRL &trans   &trans   &kp PIPE   &kp GRAVE &trans      &kp UNDER &kp LBRC  &kp RBRC  &kp PLUS  &trans    &trans
                               &kp LGUI   &trans    &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     | CAPS|   |     |     |     |     |     |      |
// |      |     |     |  IN |     |     |   | PREV| VOL-| VOL+| NEXT|     |      |
// |      |     |     |     |     |     |   |     | PP  | MUTE|     |     |      |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &trans &trans &trans &trans            &trans      &trans     &kp CAPS     &trans       &trans       &trans     &trans &trans
   &trans &trans &trans &kp LC(LA(SPACE)) &trans      &trans     &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &trans &trans
   &trans &trans &trans &trans            &trans      &trans     &trans       &kp C_PP     &kp C_MUTE   &trans     &trans &trans
                        &trans            &trans      &trans     &trans       &trans       &trans
                        >;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };
};
